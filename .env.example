MAOQ_DB_PATH=data/orchestrator.db
MAOQ_WORKSPACE_ROOT=.
MAOQ_DEFAULT_EXECUTOR=simulated
MAOQ_API_TOKEN=change-me
MAOQ_MAX_OUTPUT_BYTES=20000

# Modelos nativos gratuitos (config/default.yaml es la fuente de verdad).
# Deja estas variables vacias para usar YAML; solo define MAOQ_* para activar NVIDIA.
MAOQ_KILO_MODEL=kilo/cohere/north-mini-code:free
MAOQ_KILO_BIN=C:\Users\javier\AppData\Roaming\npm\kilo.cmd
MAOQ_CLINE_BIN=C:\Users\javier\AppData\Roaming\npm\cline.cmd
MAOQ_CLINE_MODEL=anthropic/claude-sonnet-5
MAOQ_CLINE_PROVIDER=cline
MAOQ_HERMES_MODEL=nvidia/nemotron-3-ultra-550b-a55b
MAOQ_HERMES_PROVIDER=nvidia
MAOQ_HERMES_BIN=C:\Users\javier\.local\bin\hermes.CMD

# Claves gratuitas: NVIDIA NIM para los modelos NVIDIA free.
NVIDIA_API_KEY=
# Claves opcionales para otros proveedores si se reconfiguran.
OPENROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
