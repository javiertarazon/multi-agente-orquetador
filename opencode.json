{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "default": "orchestrator",
    "orchestrator": {
      "description": "Orquestador multi-agente: planifica, delega y supervisa",
      "model": "nvidia/nemotron-3-nano-30b-a3b:free",
      "temperature": 0.2,
      "tools": {
        "multi-agente-orquestado_*": "allow",
        "read": "allow",
        "edit": "deny",
        "bash": "deny"
      }
    }
  },
  "mcp": {
    "multi-agente-orquestado": {
      "type": "local",
      "command": ["${workspaceRoot}/scripts/mcp_wrapper.bat"],
      "environment": {
        "PYTHONPATH": "src",
        "MAOQ_REQUIRE_REAL_EXECUTORS": "1"
      }
    }
  }
}
